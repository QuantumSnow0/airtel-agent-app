{
  "expo": {
    "name": "WAM Apps",
    "slug": "wam-apps",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wamapps",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.wam.apps",
      "googleServicesFile": "./google-services.json",
      "versionCode": 13,
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "manifestQueries": {
        "package": [
          "com.airtel.airtelwork.africa"
        ],
        "intent": [
          {
            "action": "android.intent.action.MAIN",
            "category": [
              "android.intent.category.LAUNCHER"
            ]
          },
          {
            "action": "android.intent.action.DIAL",
            "data": [
              {
                "scheme": "tel"
              }
            ]
          }
        ]
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "wamapps"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E53935",
          "defaultChannel": "wam_alerts",
          "sounds": [
            "./assets/sounds/lead_push_alert.wav",
            "./assets/sounds/lead_offer.wav"
          ]
        }
      ],
      "./plugins/withLeadOfferNotificationIcons.js",
      "./plugins/withPlayStoreCompliance.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79ca40ff-774f-4322-bf65-0adc31b78223"
      }
    }
  }
}
